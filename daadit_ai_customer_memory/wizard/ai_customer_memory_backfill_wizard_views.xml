<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_ai_customer_memory_backfill_wizard_form" model="ir.ui.view">
        <field name="name">daadit.ai.customer.memory.backfill.wizard.form</field>
        <field name="model">daadit.ai.customer.memory.backfill.wizard</field>
        <field name="arch" type="xml">
            <form string="Index Existing Tickets/Tasks">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        This action sends source text to the selected AI agent. Use a limited batch size.
                    </div>
                    <group>
                        <field name="source_type"/>
                        <field name="limit"/>
                        <field name="force_reindex"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Start Indexing" name="action_run_backfill" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ai_customer_memory_backfill_wizard" model="ir.actions.act_window">
        <field name="name">Index Existing Tickets/Tasks</field>
        <field name="res_model">daadit.ai.customer.memory.backfill.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_ai_customer_memory_backfill_wizard_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_ai_customer_memory_backfill" name="Index Existing Tickets/Tasks" parent="helpdesk.menu_helpdesk_root" action="action_ai_customer_memory_backfill_wizard" sequence="87" groups="base.group_system"/>
</odoo>
