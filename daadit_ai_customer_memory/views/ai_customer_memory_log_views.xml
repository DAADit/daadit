<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_ai_customer_memory_log_list" model="ir.ui.view">
        <field name="name">daadit.ai.customer.memory.log.list</field>
        <field name="model">daadit.ai.customer.memory.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/>
                <field name="partner_id"/>
                <field name="source_model"/>
                <field name="state"/>
                <field name="agent_name"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="view_ai_customer_memory_log_form" model="ir.ui.view">
        <field name="name">daadit.ai.customer.memory.log.form</field>
        <field name="model">daadit.ai.customer.memory.log</field>
        <field name="arch" type="xml">
            <form string="AI Customer Memory Log" create="0" edit="0">
                <header>
                    <button name="action_open_source" type="object" string="Open Source" class="btn-primary" invisible="source_model == 'manual' or not source_res_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="success,skipped,error"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="source_model"/>
                            <field name="source_res_id"/>
                            <field name="ticket_id"/>
                            <field name="task_id"/>
                        </group>
                        <group>
                            <field name="agent_ref"/>
                            <field name="agent_name"/>
                            <field name="message"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Created Memories">
                            <field name="memory_ids" readonly="1">
                                <list>
                                    <field name="category"/>
                                    <field name="memory"/>
                                    <field name="solution_summary"/>
                                    <field name="confidence"/>
                                </list>
                            </field>
                        </page>
                        <page string="Source JSON Sent">
                            <field name="source_json" nolabel="1"/>
                        </page>
                        <page string="Prompt Sent">
                            <field name="prompt" nolabel="1"/>
                        </page>
                        <page string="Raw Response">
                            <field name="raw_response" nolabel="1"/>
                        </page>
                        <page string="Parsed Response">
                            <field name="parsed_response" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ai_customer_memory_log_search" model="ir.ui.view">
        <field name="name">daadit.ai.customer.memory.log.search</field>
        <field name="model">daadit.ai.customer.memory.log</field>
        <field name="arch" type="xml">
            <search string="AI Customer Memory Logs">
                <field name="partner_id"/>
                <field name="source_model"/>
                <field name="state"/>
                <field name="message"/>
            </search>
        </field>
    </record>

    <record id="action_ai_customer_memory_log" model="ir.actions.act_window">
        <field name="name">AI Customer Memory Logs</field>
        <field name="res_model">daadit.ai.customer.memory.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ai_customer_memory_log_search"/>
    </record>

    <menuitem id="menu_ai_customer_memory_log" name="AI Memory Logs" parent="helpdesk.menu_helpdesk_root" action="action_ai_customer_memory_log" sequence="87" groups="base.group_system"/>
</odoo>
