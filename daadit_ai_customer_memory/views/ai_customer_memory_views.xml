<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_ai_customer_memory_list" model="ir.ui.view">
        <field name="name">daadit.ai.customer.memory.list</field>
        <field name="model">daadit.ai.customer.memory</field>
        <field name="arch" type="xml">
            <list>
                <field name="indexed_at"/>
                <field name="partner_id"/>
                <field name="source_model"/>
                <field name="category"/>
                <field name="importance"/>
                <field name="memory"/>
                <field name="solution_summary"/>
                <field name="confidence"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_ai_customer_memory_form" model="ir.ui.view">
        <field name="name">daadit.ai.customer.memory.form</field>
        <field name="model">daadit.ai.customer.memory</field>
        <field name="arch" type="xml">
            <form string="AI Customer Memory">
                <header>
                    <button name="action_open_source" type="object" string="Open Source" class="btn-primary" invisible="source_model == 'manual' or not source_res_id"/>
                    <button name="action_archive" type="object" string="Archive" invisible="state != 'active'"/>
                    <button name="action_activate" type="object" string="Activate" invisible="state == 'active'"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,archived,error"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="commercial_partner_id" readonly="1"/>
                            <field name="category"/>
                            <field name="importance"/>
                        </group>
                        <group>
                            <field name="source_model"/>
                            <field name="source_res_id"/>
                            <field name="ticket_id"/>
                            <field name="task_id"/>
                            <field name="confidence"/>
                            <field name="indexed_at"/>
                        </group>
                    </group>
                    <group>
                        <field name="memory" placeholder="Compact reusable customer memory..."/>
                        <field name="solution_summary" placeholder="Compact solution / work done..."/>
                    </group>
                    <group invisible="not error_message">
                        <field name="error_message"/>
                        <field name="log_id"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ai_customer_memory_search" model="ir.ui.view">
        <field name="name">daadit.ai.customer.memory.search</field>
        <field name="model">daadit.ai.customer.memory</field>
        <field name="arch" type="xml">
            <search string="AI Customer Memory">
                <field name="memory"/>
                <field name="solution_summary"/>
                <field name="partner_id"/>
                <field name="category"/>
            </search>
        </field>
    </record>

    <record id="action_ai_customer_memory" model="ir.actions.act_window">
        <field name="name">AI Customer Memory</field>
        <field name="res_model">daadit.ai.customer.memory</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ai_customer_memory_search"/>
        <field name="domain">[('state', '=', 'active')]</field>
    </record>

    <menuitem id="menu_ai_customer_memory" name="AI Customer Memory" parent="helpdesk.menu_helpdesk_root" action="action_ai_customer_memory" sequence="85"/>
</odoo>
