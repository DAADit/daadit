<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ai_router_log_view_list" model="ir.ui.view">
        <field name="name">ai.router.log.list</field>
        <field name="model">ai.router.log</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <field name="create_date"/>
                <field name="purpose"/>
                <field name="routing" optional="show"/>
                <field name="provider_id"/>
                <field name="model_name"/>
                <field name="caller"/>
                <field name="status" decoration-success="status == 'ok'"
                       decoration-warning="status == 'fallback'"
                       decoration-danger="status == 'error'"/>
                <field name="latency_ms"/>
                <field name="tokens_prompt"/>
                <field name="tokens_completion"/>
            </list>
        </field>
    </record>

    <record id="ai_router_log_view_form" model="ir.ui.view">
        <field name="name">ai.router.log.form</field>
        <field name="model">ai.router.log</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date"/>
                            <field name="purpose"/>
                            <field name="route_id"/>
                            <field name="caller"/>
                        </group>
                        <group>
                            <field name="provider_id"/>
                            <field name="model_name"/>
                            <field name="status"/>
                            <field name="latency_ms"/>
                            <field name="tokens_prompt"/>
                            <field name="tokens_completion"/>
                        </group>
                    </group>
                    <group>
                        <field name="error"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ai_router_log_action" model="ir.actions.act_window">
        <field name="name">Logboek</field>
        <field name="res_model">ai.router.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
