<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ai_router_dispatch_view_list" model="ir.ui.view">
        <field name="name">ai.router.dispatch.list</field>
        <field name="model">ai.router.dispatch</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="source"/>
                <field name="purpose"/>
                <field name="team_id"/>
                <field name="max_per_run"/>
                <field name="last_run"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="ai_router_dispatch_view_form" model="ir.ui.view">
        <field name="name">ai.router.dispatch.form</field>
        <field name="model">ai.router.dispatch</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Werkregel">
                            <field name="name"/>
                            <field name="source"/>
                            <field name="purpose"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Bereik en gedrag">
                            <field name="team_id"/>
                            <field name="max_per_run"/>
                            <field name="activity_summary"/>
                            <field name="last_run"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ai_router_dispatch_action" model="ir.actions.act_window">
        <field name="name">Werkregels</field>
        <field name="res_model">ai.router.dispatch</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
