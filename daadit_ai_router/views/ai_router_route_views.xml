<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ai_router_route_view_list" model="ir.ui.view">
        <field name="name">ai.router.route.list</field>
        <field name="model">ai.router.route</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="purpose"/>
                <field name="routing_mode"/>
                <field name="provider_id" optional="show"/>
                <field name="model_id" optional="show"/>
                <field name="fallback_provider_id" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="ai_router_route_view_form" model="ir.ui.view">
        <field name="name">ai.router.route.form</field>
        <field name="model">ai.router.route</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Route">
                            <field name="name"/>
                            <field name="purpose"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Bestemming">
                            <field name="routing_mode" widget="radio"/>
                            <field name="provider_id"
                                   invisible="routing_mode == 'auto'"/>
                            <field name="model_id"
                                   placeholder="standaardmodel van de provider"
                                   invisible="routing_mode == 'auto'"/>
                            <field name="fallback_provider_id"
                                   invisible="routing_mode == 'auto'"/>
                            <field name="fallback_model_id"
                                   invisible="routing_mode == 'auto'"/>
                        </group>
                    </group>
                    <group string="Limieten">
                        <field name="max_tokens"/>
                        <field name="temperature"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ai_router_route_action" model="ir.actions.act_window">
        <field name="name">Routes</field>
        <field name="res_model">ai.router.route</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
