<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Two "Call via Teams" buttons on the standard partner form:
         - one next to the phone field (PSTN dial)
         - one next to the email field (Teams-user call by UPN, no PSTN)
         Each is hidden when its source field is empty. -->
    <record id="view_partner_form_teams_call" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.daadit.teams.call</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='phone']" position="after">
                <button name="action_call_via_teams"
                        type="object"
                        class="btn btn-link p-0 ms-2"
                        icon="fa-phone"
                        string="Call via Teams"
                        invisible="not phone"/>
            </xpath>
            <xpath expr="//field[@name='email']" position="after">
                <button name="action_call_via_teams_email"
                        type="object"
                        class="btn btn-link p-0 ms-2"
                        icon="fa-comments-o"
                        string="Call Teams user"
                        invisible="not email"/>
            </xpath>
        </field>
    </record>
</odoo>
