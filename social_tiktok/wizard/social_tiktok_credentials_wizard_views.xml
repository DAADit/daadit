<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="social_tiktok_credentials_wizard_view_form" model="ir.ui.view">
        <field name="name">social.tiktok.credentials.wizard.view.form</field>
        <field name="model">social.tiktok.credentials.wizard</field>
        <field name="arch" type="xml">
            <form>
                <div class="alert alert-info" role="alert">
                    Connecting TikTok requires a (free) TikTok developer app — a one-time setup.
                    <ol class="mb-0 mt-2">
                        <li>Create an app on <a href="https://developers.tiktok.com/apps" target="_blank">developers.tiktok.com</a>.</li>
                        <li>Add the products <b>Login Kit</b> and <b>Content Posting API</b>.</li>
                        <li>Register the Redirect URI shown below in the Login Kit settings.</li>
                        <li>Copy the app's <b>Client Key</b> and <b>Client Secret</b> here and connect.</li>
                    </ol>
                </div>
                <group>
                    <field name="redirect_uri" readonly="1"/>
                    <field name="client_key"/>
                    <field name="client_secret" password="True"/>
                </group>
                <footer>
                    <button string="Connect TikTok account" type="object" name="action_connect" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
